# SentinelTrace Environment Configuration
# Copy this file to .env to configure local settings:
#   copy .env.example .env

# NuGen AI Intelligence Assistant (Optional demo capability)
#
# This is the one outbound call in the whole product. It is supplementary: the
# assistant explains method and interprets results, and nothing it returns can
# change a mask, a drift field, a score or an attribution. With the key empty
# the panel still loads and says the assistant is not configured -- the rest of
# the console stays fully offline.
NUGEN_API_KEY=
NUGEN_MODEL_ID=model_01m72rrs9crb43tz
NUGEN_API_URL=https://api.nugen.in/api/v3/inference/chat/completions
# Seconds before the assistant gives up and says so. 12s is ~4x the measured
# latency; longer budgets read as a hung panel in front of a judge.
NUGEN_TIMEOUT_S=12
# Turns resent per request. History is replayed in full each call.
NUGEN_MAX_HISTORY=12
